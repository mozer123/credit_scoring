    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Loan Default Prediction"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {},
      "outputs": [],
      "source": [
        "%load_ext autoreload\n",
        "%autoreload 2\n",
        "\n",
        "from scripts.utilities import *\n",
        "from scripts.features import *"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Load and Process Data"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Data successfully loaded and processed.\n"
          ]
        }
      ],
      "source": [
        "# Load raw data\n",
        "consumer_df, account_df, transaction_df = get_data()\n",
        "\n",
        "# Filter unknown consumers\n",
        "consumer_df, account_df, transaction_df = filter_unknown(consumer_df, account_df, transaction_df)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "\n",
            "Feature Execution Plan:\n",
            "- Total feature creation functions: 7\n",
            "- Unchanged feature creation functions: 7 (using cached results)\n",
            "\n",
            "No feature creation functions need to be executed.\n",
            "- Using cached result for average_transaction_amount\n",
            "- Using cached result for net_monthly_cash_flow\n",
            "- Using cached result for average_account_balance\n",
            "- Using cached result for time_based_average_transaction_amounts\n",
            "- Using cached result for descriptive_stats_by_category\n",
            "- Using cached result for outflow_stats\n",
            "- Using cached result for outflow_over_time_fix\n",
            "\n",
            "Total Created Features:  257\n"
          ]
        }
      ],
      "source": [
        "# Define feature functions\n",
        "selected_features = [\n",
        "    average_transaction_amount,\n",
        "    net_monthly_cash_flow,\n",
        "    average_account_balance,\n",
        "    time_based_average_transaction_amounts,\n",
        "    descriptive_stats_by_category,\n",
        "    outflow_stats,\n",
        "    outflow_over_time_fix\n",
        "]\n",
        "\n",
        "# Calculate features\n",
        "feature_dataframes = execute_selected_features(selected_features, account_df, transaction_df)\n",
        "final_features = merge_features(feature_dataframes)\n",
        "\n",
        "# Merge with consumer data\n",
        "ml_features = consumer_df.merge(final_features, how=\"left\", on=\"prism_consumer_id\")\n",
        "ml_features = ml_features.apply(lambda col: col.fillna(0) if col.name != \"DQ_TARGET\" else col)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2 Split Data"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Training set size: 7591\n",
            "No validation set created.\n",
            "Test set size: 2531\n"
          ]
        }
      ],
      "source": [
        "# Split with validation set for hyperparameter tuning\n",
        "train_df, _, test_df = split_data(ml_features, test_size=0.25)\n",
        "\n",
        "# Define feature columns\n",
        "exclude_columns = ['prism_consumer_id', 'evaluation_date', 'credit_score', 'DQ_TARGET']\n",
        "all_feature_columns = [col for col in train_df.columns if col not in exclude_columns]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Feature Selection"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {},
      "outputs": [
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 1200x1200 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "# Initialize the feature selector with your training DataFrame, feature columns, and any forced features.\n",
        "fs = FeatureSelector(train_df, all_feature_columns)\n",
        "\n",
        "# Run feature selection using the desired method(s)\n",
        "# available --> ['mutual_info', 'random_forest', 'xgboost']\n",
        "fs.run_feature_selection(methods=['mutual_info'], n_features=50)\n",
        "\n",
        "# Retrieve the selected features for a given method\n",
        "feature_columns = fs.get_selected_features('mutual_info')\n",
        "\n",
        "# Plot the importance scores for the selected method\n",
        "fs.plot_feature_importance('mutual_info', top_n=50)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
